{
  "log": { "level": "info", "timestamp": true },
  "experimental": {
    "cache_file": { "enabled": true, "path": "cache.db" }
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.16.0.1/30"],
      "mtu": 1492,
      "auto_route": true,
      "strict_route": false,
      "stack": "system"
    },
    {
      "type": "mixed",
      "tag": "proxy-in",
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "sniff": true,
      "sniff_override_destination": true,
      "set_system_proxy": true
    }
  ]
}
